rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isFaculty() {
      return isAuthenticated() && getUserData().role == 'faculty';
    }

    function isStudent() {
      return isAuthenticated() && getUserData().role == 'student';
    }

    // 1. User Profiles (users/{uid})
    match /users/{uid} {
      allow read: if isAuthenticated();

      // User profiles and roles are created and updated EXCLUSIVELY by the trusted backend
      // (Firebase Admin SDK). Direct client-side creation, update, or deletion is strictly prohibited
      // to prevent role manipulation or bypassing server-side classification.
      allow create, update, delete: if false;
    }

    // 2. Courses (courses/{courseId})
    match /courses/{courseId} {
      allow read: if isAuthenticated();

      allow create: if isFaculty() && 
                       request.resource.data.facultyEmail == request.auth.token.email;

      // Faculty owner can manage course; students can only update enrolledStudents list when joining
      allow update: if (isFaculty() && resource.data.facultyEmail == request.auth.token.email) ||
                       (isStudent() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledStudents']));

      allow delete: if isFaculty() && resource.data.facultyEmail == request.auth.token.email;
    }

    // 3. Active Session Pointers (sessions/{courseCode})
    match /sessions/{courseCode} {
      allow read: if isAuthenticated();

      // Sessions are created and managed strictly by backend Cloud Functions (startAttendanceSession, stopAttendanceSession)
      allow create, update, delete: if false;
    }

    // 4. Historical & Immutable Attendance Sessions (attendance_sessions/{sessionId})
    match /attendance_sessions/{sessionId} {
      allow read: if isAuthenticated();

      // Historical sessions are recorded strictly by backend Cloud Functions (startAttendanceSession)
      allow create, update, delete: if false;
    }

    // 5. QR Tokens (qr_tokens/{tokenId})
    match /qr_tokens/{tokenId} {
      allow read: if isAuthenticated();
      // QR tokens can strictly be issued ONLY by backend Cloud Functions
      allow create, update, delete: if false;
    }

    // 6. Attendance Claims (attendance_claims/{claimId})
    match /attendance_claims/{claimId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.studentUid || isFaculty());
      // Claims are issued strictly by backend Cloud Functions during validated QR check
      allow create, update, delete: if false;
    }

    // 7. Attendance Records (attendance_records/{recordId})
    match /attendance_records/{recordId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.studentUid || isFaculty());

      function isAuthorizedFacultyForRecord() {
        return isFaculty() &&
               (
                 (exists(/databases/$(database)/documents/attendance_sessions/$(resource.data.sessionId)) &&
                  get(/databases/$(database)/documents/attendance_sessions/$(resource.data.sessionId)).data.facultyEmail == request.auth.token.email) ||
                 (exists(/databases/$(database)/documents/sessions/$(resource.data.courseCode)) &&
                  get(/databases/$(database)/documents/sessions/$(resource.data.courseCode)).data.facultyEmail == request.auth.token.email)
               );
      }

      function isAuthorizedFacultyForRecordData(data) {
        return isFaculty() &&
               (
                 (exists(/databases/$(database)/documents/attendance_sessions/$(data.sessionId)) &&
                  get(/databases/$(database)/documents/attendance_sessions/$(data.sessionId)).data.facultyEmail == request.auth.token.email) ||
                 (exists(/databases/$(database)/documents/sessions/$(data.courseCode)) &&
                  get(/databases/$(database)/documents/sessions/$(data.courseCode)).data.facultyEmail == request.auth.token.email)
               );
      }

      // Student submission constraints:
      // - Must be authenticated
      // - Must submit on their own behalf (studentUid matches caller uid)
      // - Cannot directly claim APPROVED status (must be REVIEW, PENDING, or REJECTED)
      // - Must specify a valid sessionId
      // - Document ID must strictly equal "${sessionId}_${studentUid}" to enforce one record per student per session
      // - Must possess an authorized attendance claim issued by validateQrToken (NO manual-request bypass)
      // - Claim studentUid, sessionId, and courseCode must strictly match request data
      // - Faculty write must be by authorized faculty owning the course/session
      allow create: if (isAuthenticated() &&
                        request.auth.uid == request.resource.data.studentUid &&
                        recordId == (request.resource.data.sessionId + "_" + request.auth.uid) &&
                        request.resource.data.studentEmail == request.auth.token.email &&
                        request.resource.data.status != 'APPROVED' &&
                        request.resource.data.sessionId != null &&
                        request.resource.data.sessionId != '' &&
                        exists(/databases/$(database)/documents/attendance_claims/$(recordId)) &&
                        get(/databases/$(database)/documents/attendance_claims/$(recordId)).data.studentUid == request.auth.uid &&
                        get(/databases/$(database)/documents/attendance_claims/$(recordId)).data.sessionId == request.resource.data.sessionId &&
                        (!('courseCode' in get(/databases/$(database)/documents/attendance_claims/$(recordId)).data) ||
                         get(/databases/$(database)/documents/attendance_claims/$(recordId)).data.courseCode == request.resource.data.courseCode) &&
                        (!('overallScore' in request.resource.data) ||
                         (request.resource.data.overallScore is int && request.resource.data.overallScore >= 0 && request.resource.data.overallScore <= 100))) ||
                       (isAuthorizedFacultyForRecordData(request.resource.data) &&
                        recordId == (request.resource.data.sessionId + "_" + request.resource.data.studentUid));

      // Update constraints:
      // Students cannot modify records once submitted.
      // Only authorized faculty who owns the course/session can approve or reject records.
      // Retries or repeated manual approvals are safe as long as core identifiers (studentUid, sessionId, courseCode) are preserved.
      allow update: if isAuthorizedFacultyForRecord() &&
                       (request.resource.data.diff(resource.data).affectedKeys().size() == 0 ||
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason']) ||
                        (resource.data.matchResult == 'MANUAL_REQUEST_APPROVED' &&
                         request.resource.data.studentUid == resource.data.studentUid &&
                         request.resource.data.sessionId == resource.data.sessionId &&
                         request.resource.data.courseCode == resource.data.courseCode));

      allow delete: if false;
    }

    // 8. Manual Attendance Requests (manual_attendance_requests/{requestId})
    match /manual_attendance_requests/{requestId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.studentUid || isFaculty());

      function isAuthorizedFacultyForManualRequest() {
        return isFaculty() &&
               (
                 (exists(/databases/$(database)/documents/attendance_sessions/$(resource.data.sessionId)) &&
                  get(/databases/$(database)/documents/attendance_sessions/$(resource.data.sessionId)).data.facultyEmail == request.auth.token.email) ||
                 (exists(/databases/$(database)/documents/sessions/$(resource.data.courseCode)) &&
                  get(/databases/$(database)/documents/sessions/$(resource.data.courseCode)).data.facultyEmail == request.auth.token.email)
               );
      }

      // Student submission constraints for unverified manual requests:
      // - Must be authenticated
      // - Must submit on their own behalf
      // - Cannot directly claim APPROVED status (must be REVIEW or PENDING)
      // - Must be explicitly flagged as matchResult == 'MANUAL_REQUEST' and isQrVerified == false
      // - Document ID must strictly equal "${sessionId}_${studentUid}"
      // - Session must exist in attendance_sessions and match courseCode (no synthetic or cross-course IDs)
      // - Score must be within valid range [0, 100]
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.studentUid &&
                       requestId == (request.resource.data.sessionId + "_" + request.auth.uid) &&
                       request.resource.data.studentEmail == request.auth.token.email &&
                       request.resource.data.status != 'APPROVED' &&
                       request.resource.data.status in ['REVIEW', 'PENDING'] &&
                       request.resource.data.matchResult == 'MANUAL_REQUEST' &&
                       request.resource.data.isQrVerified == false &&
                       request.resource.data.sessionId != null &&
                       request.resource.data.sessionId != '' &&
                       exists(/databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)) &&
                       get(/databases/$(database)/documents/attendance_sessions/$(request.resource.data.sessionId)).data.courseCode == request.resource.data.courseCode &&
                       (!('overallScore' in request.resource.data) ||
                        (request.resource.data.overallScore is int && request.resource.data.overallScore >= 0 && request.resource.data.overallScore <= 100));

      // Only authorized faculty who owns the course/session can approve or reject manual attendance requests.
      // Students cannot modify their manual request once submitted.
      allow update: if isAuthorizedFacultyForManualRequest() &&
                       (request.resource.data.diff(resource.data).affectedKeys().size() == 0 ||
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason']));

      allow delete: if false;
    }
  }
}
